# Copy to .env and fill in. Never commit .env. Full walkthrough: docs/SETUP.md

# Vapi (voice agent + outbound calls) - dashboard.vapi.ai -> API Keys -> Private key
VAPI_API_KEY=

# Twilio (phone number that Vapi dials out from) - console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1
TWILIO_VERIFY_SERVICE_SID=       # optional: Twilio Verify service used before live calls

# Your cell phone, E.164 (the only number hiyo is allowed to call)
OWNER_PHONE_NUMBER=+1

# Google Calendar -> Settings -> your calendar -> "Secret address in iCal format"
GOOGLE_CALENDAR_ICAL_URL=
CALENDAR_MODE=fixture         # fixture | live (live needs the iCal URL)

# Optional: used for the bounded decision reasoner
OPENAI_API_KEY=

# Optional: ElevenLabs xi-api-key (if the call voice switches to ElevenLabs TTS)
ELEVENLABS_API_KEY=

# --- hiyo engine additions ---

# Dispatcher: dryrun (default, no calls placed) or vapi
DISPATCHER=dryrun

# Vapi phone number ID (dashboard.vapi.ai -> Phone Numbers -> imported Twilio number)
VAPI_PHONE_NUMBER_ID=

# Public base URL Vapi uses to reach this service (e.g. https://xxxx.ngrok.io)
PUBLIC_BASE_URL=

# Shared secret Vapi sends as x-vapi-secret header on /vapi/* webhooks (optional)
VAPI_WEBHOOK_SECRET=

# Operator token required on mutating /api/* endpoints when set
HIYO_OPERATOR_TOKEN=

# BLE address of WHOOP strap (macOS CoreBluetooth UUID from scripts/scan_whoop.py)
WHOOP_ADDR=

# Voice (optional overrides; default ElevenLabs Bso1TGGDyQftAIQje0JM on Flash v2.5)
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_MODEL=
NUDGE_CHANNEL=dryrun          # dryrun | textbelt | imessage | none
HIYO_TEXT_MODEL=gpt-4.1
TEXTBELT_API_KEY=             # textbelt.com key; append "_test" to dry-run
HIYO_ONBOARDING_TOKEN=       # shared secret for web/api -> engine onboarding

# WHOOP official OAuth (server-side only; register the exact callback in WHOOP Developer Dashboard)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
HIYO_WEB_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
