# Copy to .env and fill in. Never commit .env.

# Vapi (voice agent + outbound calls) - dashboard.vapi.ai -> API Keys -> Private key
VAPI_API_KEY=

# Twilio (phone number that Vapi dials out from) - console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1

# Your cell phone, E.164 (the only number hiyo is allowed to call)
OWNER_PHONE_NUMBER=+1

# Google Calendar -> Settings -> your calendar -> "Secret address in iCal format"
GOOGLE_CALENDAR_ICAL_URL=

# Optional: used for the bounded decision reasoner
OPENAI_API_KEY=

# --- hiyo engine additions ---

# Dispatcher: dryrun (default, no calls placed) or vapi
DISPATCHER=dryrun

# Vapi phone number ID (dashboard.vapi.ai -> Phone Numbers -> imported Twilio number)
VAPI_PHONE_NUMBER_ID=

# Public base URL Vapi uses to reach this service (e.g. https://xxxx.ngrok.io)
PUBLIC_BASE_URL=

# Shared secret Vapi sends as x-vapi-secret header on /vapi/* webhooks (optional)
VAPI_WEBHOOK_SECRET=

# Operator token required on mutating /api/* endpoints when set
HIYO_OPERATOR_TOKEN=

# BLE address of WHOOP strap (macOS CoreBluetooth UUID from scripts/scan_whoop.py)
WHOOP_ADDR=

# Voice (optional overrides; default ElevenLabs Jessica on Flash v2.5)
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
VAPI_VOICE_MODEL=
