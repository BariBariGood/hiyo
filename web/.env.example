# Server-side only — never NEXT_PUBLIC_ (token must stay off the client)
HIYO_API_URL=http://127.0.0.1:8787   # the local engine (or your tunnel URL)
HIYO_ONBOARDING_TOKEN=               # must match HIYO_ONBOARDING_TOKEN in the engine's .env
# Required for a production build: private owner setup link /onboarding?setup=<key>
# Use a long random value. Stored only on the web server, never NEXT_PUBLIC_.
HIYO_SETUP_KEY=
